{
  "schemaVersion": 1,
  "id": "paranoic",
  "version": "${version}",
  "name": "Paranoic",
  "authors": ["sk666G", "Cypphi"],
  "contact": {
    "sources": "https://github.com/sk666G/paranoic"
  },
  "icon": "assets/paranoic/textures/icon.png",
  "description": "Paranoic is a Fabric client for Minecraft 1.21.11, based on the Open Zio codebase.",
  "environment": "client",
  "accessWidener": "zio.accesswidener",
  "entrypoints": {
    "main": [
