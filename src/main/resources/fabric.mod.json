    ],
    "client": [
      "dev.zio.client.ZioClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone-meteor": "1.21.11-SNAPSHOT",
    "viafabricplus": "4.4.9",
    "entityculling": "*",
    "sodium": "*",
    "lithium": "*",
    "immediatelyfast": "*",
    "xaerominimap": "*"
  },
  "mixins": [
    "zio.mixins.json"
  ]
